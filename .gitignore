.DS_Store
*.log
node_modules/

# Entwurfsmaterial mit lizenzierten Schriften (Fontshare-EULA verbietet
# Weitergabe) — liegt lokal, gehoert nicht in die Git-Historie
Designe idehen planspiel/

# Cloudflare-Wrangler-Zwischenstaende
.wrangler/

# Bespoke-Stencil-Schriftdateien (Fontshare-EULA, siehe ui/fonts/README.md)
makro-planspiel/ui/fonts/*.woff2

# Laufzeitkonfiguration — enthaelt Adressen und Zugangsschluessel und wird je
# Umgebung anders gesetzt. Vorlage: konfig.beispiel.js
#
# Der Schraegstrich am Anfang ist wichtig: ohne ihn schluesse das Muster auch
# js/konfig.js aus, und das ist Quellcode.
/konfig.js

# Aufnahmen aus den Gestaltungspruefungen: 9 MB Bilder, jederzeit neu
# erzeugbar. Der Text daneben (critique/, surfaces/, design.json) bleibt.
.impeccable/review/

# LaTeX-Zwischenstände der Modelldokumentation (das PDF wird mit abgelegt)
docs/modell/*.aux
docs/modell/*.fdb_latexmk
docs/modell/*.fls
docs/modell/*.out
docs/modell/*.toc
